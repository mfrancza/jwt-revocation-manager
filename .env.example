# GitHub Packages credentials for resolving jwt-revocation-rules and
# jwt-revocation-ktor-server-auth (see build.gradle.kts).
#
# Copy to .env and fill in:
#   cp .env.example .env
#
# GITHUB_TOKEN must be a *classic* PAT with at least `read:packages`
# (and `write:packages` if you intend to run `./gradlew publish` locally).
# Fine-grained PATs are not accepted by GitHub Packages' Maven registry.
#
# Usage:
#   set -a; source .env; set +a
#   ./gradlew build
GITHUB_ACTOR=mfrancza
GITHUB_TOKEN=
